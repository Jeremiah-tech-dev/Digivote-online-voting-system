# Copy these into your hosting provider's environment settings (e.g. Render),
# or export them in your shell for local development.

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# The first admin account is created on startup if it doesn't exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Demo mode: fill an EMPTY database with sample voters and ballots so the admin
# dashboards have data. Demo voters have IDs 20000001-20000116 and share one password.
# Never enable this for a real election.
# DEMO_DATA=true
# DEMO_VOTER_PASSWORD=Demo1234

# Frontend URLs allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,https://digivote-online-voting-system.vercel.app

# Optional: defaults to SQLite in backend/instance/voters.db
# DATABASE_URL=sqlite:///./instance/voters.db

# Optional: how long a login lasts, in minutes
# VOTER_TOKEN_EXPIRE_MINUTES=30
# ADMIN_TOKEN_EXPIRE_MINUTES=60
